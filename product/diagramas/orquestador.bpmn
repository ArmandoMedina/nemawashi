<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definiciones_orquestador" targetNamespace="http://nemawashi/diagramas" exporter="escrito a mano" exporterVersion="1.0">
  <bpmn:import importType="http://www.omg.org/spec/BPMN/20100524/MODEL" location="agente-desarrollador.bpmn" namespace="http://nemawashi/diagramas" />
  <bpmn:import importType="http://www.omg.org/spec/BPMN/20100524/MODEL" location="agente-qa.bpmn" namespace="http://nemawashi/diagramas" />
  <bpmn:import importType="http://www.omg.org/spec/BPMN/20100524/MODEL" location="agente-auditor.bpmn" namespace="http://nemawashi/diagramas" />
  <bpmn:import importType="http://www.omg.org/spec/BPMN/20100524/MODEL" location="agente-escribano.bpmn" namespace="http://nemawashi/diagramas" />
  <bpmn:collaboration id="Colaboracion_orquestador">
    <bpmn:participant id="Pool_orquestador" name="La sesión del orquestador" processRef="Proceso_orquestador" />
    <bpmn:textAnnotation id="Nota_asiento">
      <bpmn:text>¿Hay un agente cuya carta cubra esto? Si la hay, no es del orquestador. Y sobre-mandar también es falla.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Asoc_asiento" sourceRef="O_gw_asiento" targetRef="Nota_asiento" />
    <bpmn:textAnnotation id="Nota_verificar">
      <bpmn:text>Al subagente no se le cree: su reporte es una afirmación, y quien encargó mide después.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Asoc_verificar" sourceRef="O_verificar" targetRef="Nota_verificar" />
    <bpmn:textAnnotation id="Nota_tejer">
      <bpmn:text>La síntesis es lo único de este trabajo que no se delega.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Asoc_tejer" sourceRef="O_tejer" targetRef="Nota_tejer" />
  </bpmn:collaboration>
  <bpmn:process id="Proceso_orquestador" name="Decidir con el dueño del producto y mandar a trabajar" isExecutable="false">
    <bpmn:startEvent id="O_inicio" name="Llega el dueño del producto">
      <bpmn:outgoing>O_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="SP_abrir" name="Abrir la sesión">
      <bpmn:incoming>O_f1</bpmn:incoming>
      <bpmn:outgoing>O_f2</bpmn:outgoing>
      <bpmn:startEvent id="AB_inicio" name="Sesión nueva">
        <bpmn:outgoing>AB_f1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="AB_gw" name="¿Llega con la tarea clara?">
        <bpmn:incoming>AB_f1</bpmn:incoming>
        <bpmn:outgoing>AB_f2</bpmn:outgoing>
        <bpmn:outgoing>AB_f3</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="AB_confirmar" name="Confirmar la línea en sus palabras">
        <bpmn:incoming>AB_f2</bpmn:incoming>
        <bpmn:outgoing>AB_f4</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="AB_escoger" name="Escoger con él cuál es la de hoy">
        <bpmn:incoming>AB_f3</bpmn:incoming>
        <bpmn:outgoing>AB_f5</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="AB_escribir" name="Escribir la hoja">
        <bpmn:incoming>AB_f4</bpmn:incoming>
        <bpmn:incoming>AB_f5</bpmn:incoming>
        <bpmn:outgoing>AB_f6</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="AB_fin" name="Objetivo fijado">
        <bpmn:incoming>AB_f6</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="AB_f1" sourceRef="AB_inicio" targetRef="AB_gw" />
      <bpmn:sequenceFlow id="AB_f2" name="sí" sourceRef="AB_gw" targetRef="AB_confirmar" />
      <bpmn:sequenceFlow id="AB_f3" name="no" sourceRef="AB_gw" targetRef="AB_escoger" />
      <bpmn:sequenceFlow id="AB_f4" sourceRef="AB_confirmar" targetRef="AB_escribir" />
      <bpmn:sequenceFlow id="AB_f5" sourceRef="AB_escoger" targetRef="AB_escribir" />
      <bpmn:sequenceFlow id="AB_f6" sourceRef="AB_escribir" targetRef="AB_fin" />
      <bpmn:textAnnotation id="AB_nota_hoja">
        <bpmn:text>Una línea con el objetivo, y debajo lo aparcado. Vive en el scratchpad, nunca en el repositorio.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="AB_asoc_hoja" sourceRef="AB_escribir" targetRef="AB_nota_hoja" />
    </bpmn:subProcess>
    <bpmn:task id="O_recibir" name="Recibir lo que pide">
      <bpmn:incoming>O_f2</bpmn:incoming>
      <bpmn:incoming>O_f_sigue</bpmn:incoming>
      <bpmn:outgoing>O_f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="O_gw_hecho" name="¿Es un hecho?">
      <bpmn:incoming>O_f3</bpmn:incoming>
      <bpmn:outgoing>O_f_hecho</bpmn:outgoing>
      <bpmn:outgoing>O_f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="O_hecho" name="Contestar el hecho">
      <bpmn:incoming>O_f_hecho</bpmn:incoming>
      <bpmn:outgoing>O_f_hecho2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:subProcess id="SP_decidir" name="Decidir juntos">
      <bpmn:incoming>O_f4</bpmn:incoming>
      <bpmn:outgoing>O_f5</bpmn:outgoing>
      <bpmn:startEvent id="DE_inicio" name="Hay algo que decidir">
        <bpmn:outgoing>DE_f1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="DE_nombrar" name="Nombrar la decisión que hay que tomar">
        <bpmn:incoming>DE_f1</bpmn:incoming>
        <bpmn:outgoing>DE_f2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="DE_preguntar" name="Preguntarle qué ve él">
        <bpmn:incoming>DE_f2</bpmn:incoming>
        <bpmn:outgoing>DE_f3</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="DE_gw_dime" name="¿Te dijo «dime tú»?">
        <bpmn:incoming>DE_f3</bpmn:incoming>
        <bpmn:outgoing>DE_f_dime</bpmn:outgoing>
        <bpmn:outgoing>DE_f4</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="DE_decir" name="Decir y seguir">
        <bpmn:incoming>DE_f_dime</bpmn:incoming>
        <bpmn:outgoing>DE_f_dime2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="DE_posicion" name="Dar la posición con su razón y su crux">
        <bpmn:incoming>DE_f4</bpmn:incoming>
        <bpmn:incoming>DE_f_otra</bpmn:incoming>
        <bpmn:outgoing>DE_f5</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="DE_gw_si" name="¿Salió el sí en sus palabras?">
        <bpmn:incoming>DE_f5</bpmn:incoming>
        <bpmn:outgoing>DE_f6</bpmn:outgoing>
        <bpmn:outgoing>DE_f_rebote</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="DE_ajustar" name="Recibir el rebote y ajustar la propuesta">
        <bpmn:incoming>DE_f_rebote</bpmn:incoming>
        <bpmn:outgoing>DE_f7</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="DE_gw_vivo" name="¿Sigue vivo el tema?">
        <bpmn:incoming>DE_f7</bpmn:incoming>
        <bpmn:outgoing>DE_f_otra</bpmn:outgoing>
        <bpmn:outgoing>DE_f8</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="DE_fin_cerrado" name="Cerrado con su sí">
        <bpmn:incoming>DE_f6</bpmn:incoming>
        <bpmn:incoming>DE_f_dime2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="DE_fin_abierto" name="Sin cerrar">
        <bpmn:incoming>DE_f8</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="DE_f1" sourceRef="DE_inicio" targetRef="DE_nombrar" />
      <bpmn:sequenceFlow id="DE_f2" sourceRef="DE_nombrar" targetRef="DE_preguntar" />
      <bpmn:sequenceFlow id="DE_f3" sourceRef="DE_preguntar" targetRef="DE_gw_dime" />
      <bpmn:sequenceFlow id="DE_f_dime" name="sí" sourceRef="DE_gw_dime" targetRef="DE_decir" />
      <bpmn:sequenceFlow id="DE_f_dime2" sourceRef="DE_decir" targetRef="DE_fin_cerrado" />
      <bpmn:sequenceFlow id="DE_f4" name="no" sourceRef="DE_gw_dime" targetRef="DE_posicion" />
      <bpmn:sequenceFlow id="DE_f5" sourceRef="DE_posicion" targetRef="DE_gw_si" />
      <bpmn:sequenceFlow id="DE_f6" name="sí" sourceRef="DE_gw_si" targetRef="DE_fin_cerrado" />
      <bpmn:sequenceFlow id="DE_f_rebote" name="no" sourceRef="DE_gw_si" targetRef="DE_ajustar" />
      <bpmn:sequenceFlow id="DE_f7" sourceRef="DE_ajustar" targetRef="DE_gw_vivo" />
      <bpmn:sequenceFlow id="DE_f_otra" name="sí" sourceRef="DE_gw_vivo" targetRef="DE_posicion" />
      <bpmn:sequenceFlow id="DE_f8" name="no" sourceRef="DE_gw_vivo" targetRef="DE_fin_abierto" />
      <bpmn:textAnnotation id="DE_nota_preguntar">
        <bpmn:text>Va antes de dar la posición: que se comprometa con algo primero es lo que evita que acepte lo tuyo por inercia.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="DE_asoc_preguntar" sourceRef="DE_preguntar" targetRef="DE_nota_preguntar" />
      <bpmn:textAnnotation id="DE_nota_si">
        <bpmn:text>Recomendar no es decidir. Un «bueno, como digas» no es un sí, y sin el sí no se ejecuta nada.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="DE_asoc_si" sourceRef="DE_gw_si" targetRef="DE_nota_si" />
      <bpmn:textAnnotation id="DE_nota_abierto">
        <bpmn:text>Lo no decidido se marca como no decidido, y no se escribe como si lo estuviera.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="DE_asoc_abierto" sourceRef="DE_fin_abierto" targetRef="DE_nota_abierto" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="O_desvio" name="Sale algo que no es de hoy" attachedToRef="SP_decidir" cancelActivity="false">
      <bpmn:outgoing>O_f_desvio</bpmn:outgoing>
    </bpmn:boundaryEvent>
    <bpmn:task id="O_aparcar" name="Aparcar en la hoja y volver">
      <bpmn:incoming>O_f_desvio</bpmn:incoming>
      <bpmn:outgoing>O_f_desvio2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="O_fin_aparcado" name="Anotado, sin perseguirlo">
      <bpmn:incoming>O_f_desvio2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="O_gw_decision">
      <bpmn:incoming>O_f5</bpmn:incoming>
      <bpmn:outgoing>O_f6</bpmn:outgoing>
      <bpmn:outgoing>O_f_sincerrar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="O_marcar" name="Marcar lo que quedó sin decidir">
      <bpmn:incoming>O_f_sincerrar</bpmn:incoming>
      <bpmn:outgoing>O_f_marcar2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="O_gw_asiento" name="¿Hay un asiento que lo cubra?">
      <bpmn:incoming>O_f6</bpmn:incoming>
      <bpmn:outgoing>O_f7</bpmn:outgoing>
      <bpmn:outgoing>O_f_propio</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="O_propio" name="Escribir lo que ningún asiento cubre">
      <bpmn:incoming>O_f_propio</bpmn:incoming>
      <bpmn:outgoing>O_f_propio2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:subProcess id="SP_mandar" name="Mandar a trabajar">
      <bpmn:incoming>O_f7</bpmn:incoming>
      <bpmn:incoming>O_f_devolver2</bpmn:incoming>
      <bpmn:outgoing>O_f8</bpmn:outgoing>
      <bpmn:startEvent id="MA_inicio" name="Trabajo por repartir">
        <bpmn:outgoing>MA_f1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="MA_encargo" name="Escribir el encargo">
        <bpmn:incoming>MA_f1</bpmn:incoming>
        <bpmn:outgoing>MA_f2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="MA_gw" name="¿Qué asiento lo cubre?">
        <bpmn:incoming>MA_f2</bpmn:incoming>
        <bpmn:outgoing>MA_f_desarrollador</bpmn:outgoing>
        <bpmn:outgoing>MA_f_qa</bpmn:outgoing>
        <bpmn:outgoing>MA_f_auditor</bpmn:outgoing>
        <bpmn:outgoing>MA_f_escribano</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:callActivity id="CA_desarrollador" name="Implementar con la prueba en el mismo cambio" calledElement="Proceso_desarrollador">
        <bpmn:incoming>MA_f_desarrollador</bpmn:incoming>
        <bpmn:outgoing>MA_f_desarrollador2</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:callActivity id="CA_qa" name="Cerrar por medición" calledElement="Proceso_qa">
        <bpmn:incoming>MA_f_qa</bpmn:incoming>
        <bpmn:outgoing>MA_f_qa2</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:callActivity id="CA_auditor" name="Auditar lo escrito contra el crudo" calledElement="Proceso_auditor_auditar">
        <bpmn:incoming>MA_f_auditor</bpmn:incoming>
        <bpmn:outgoing>MA_f_auditor2</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:callActivity id="CA_escribano" name="Asentar el roadmap" calledElement="Proceso_escribano_asentar">
        <bpmn:incoming>MA_f_escribano</bpmn:incoming>
        <bpmn:outgoing>MA_f_escribano2</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:exclusiveGateway id="MA_une">
        <bpmn:incoming>MA_f_desarrollador2</bpmn:incoming>
        <bpmn:incoming>MA_f_qa2</bpmn:incoming>
        <bpmn:incoming>MA_f_auditor2</bpmn:incoming>
        <bpmn:incoming>MA_f_escribano2</bpmn:incoming>
        <bpmn:outgoing>MA_f3</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="MA_fin" name="Trabajo devuelto">
        <bpmn:incoming>MA_f3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="MA_f1" sourceRef="MA_inicio" targetRef="MA_encargo" />
      <bpmn:sequenceFlow id="MA_f2" sourceRef="MA_encargo" targetRef="MA_gw" />
      <bpmn:sequenceFlow id="MA_f_desarrollador" name="código" sourceRef="MA_gw" targetRef="CA_desarrollador" />
      <bpmn:sequenceFlow id="MA_f_qa" name="medición" sourceRef="MA_gw" targetRef="CA_qa" />
      <bpmn:sequenceFlow id="MA_f_auditor" name="auditoría" sourceRef="MA_gw" targetRef="CA_auditor" />
      <bpmn:sequenceFlow id="MA_f_escribano" name="escritura" sourceRef="MA_gw" targetRef="CA_escribano" />
      <bpmn:sequenceFlow id="MA_f_desarrollador2" sourceRef="CA_desarrollador" targetRef="MA_une" />
      <bpmn:sequenceFlow id="MA_f_qa2" sourceRef="CA_qa" targetRef="MA_une" />
      <bpmn:sequenceFlow id="MA_f_auditor2" sourceRef="CA_auditor" targetRef="MA_une" />
      <bpmn:sequenceFlow id="MA_f_escribano2" sourceRef="CA_escribano" targetRef="MA_une" />
      <bpmn:sequenceFlow id="MA_f3" sourceRef="MA_une" targetRef="MA_fin" />
      <bpmn:textAnnotation id="MA_nota_encargo">
        <bpmn:text>Lo que no va en el encargo no existe para quien lo recibe: no comparte esta conversación.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="MA_asoc_encargo" sourceRef="MA_encargo" targetRef="MA_nota_encargo" />
      <bpmn:textAnnotation id="MA_nota_llamadas">
        <bpmn:text>Actividades de llamada: el camino de cada una vive en su propio archivo `agente-*.bpmn`, y el molino llama a las mismas.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="MA_asoc_llamadas" sourceRef="MA_gw" targetRef="MA_nota_llamadas" />
    </bpmn:subProcess>
    <bpmn:task id="O_verificar" name="Medir lo que volvió">
      <bpmn:incoming>O_f8</bpmn:incoming>
      <bpmn:outgoing>O_f9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="O_gw_medicion" name="¿La medición confirma el reporte?">
      <bpmn:incoming>O_f9</bpmn:incoming>
      <bpmn:outgoing>O_f10</bpmn:outgoing>
      <bpmn:outgoing>O_f_devolver</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="O_devolver" name="Devolver el encargo con lo que falló">
      <bpmn:incoming>O_f_devolver</bpmn:incoming>
      <bpmn:outgoing>O_f_devolver2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="O_tejer" name="Tejer la síntesis">
      <bpmn:incoming>O_f10</bpmn:incoming>
      <bpmn:incoming>O_f_propio2</bpmn:incoming>
      <bpmn:outgoing>O_f11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="O_gw_hoja" name="¿Queda algo de la hoja?">
      <bpmn:incoming>O_f11</bpmn:incoming>
      <bpmn:incoming>O_f_hecho2</bpmn:incoming>
      <bpmn:incoming>O_f_marcar2</bpmn:incoming>
      <bpmn:outgoing>O_f_sigue</bpmn:outgoing>
      <bpmn:outgoing>O_f12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="O_aparcado" name="Revisar lo aparcado">
      <bpmn:incoming>O_f12</bpmn:incoming>
      <bpmn:outgoing>O_f13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="O_gw_cierre">
      <bpmn:incoming>O_f13</bpmn:incoming>
      <bpmn:outgoing>O_f_limpio</bpmn:outgoing>
      <bpmn:outgoing>O_f_pendiente</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="O_fin" name="Sesión cerrada con el objetivo cumplido">
      <bpmn:incoming>O_f_limpio</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="O_fin_pendiente" name="Sesión cerrada con lo aparcado pendiente">
      <bpmn:incoming>O_f_pendiente</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="O_f1" sourceRef="O_inicio" targetRef="SP_abrir" />
    <bpmn:sequenceFlow id="O_f2" sourceRef="SP_abrir" targetRef="O_recibir" />
    <bpmn:sequenceFlow id="O_f3" sourceRef="O_recibir" targetRef="O_gw_hecho" />
    <bpmn:sequenceFlow id="O_f_hecho" name="sí" sourceRef="O_gw_hecho" targetRef="O_hecho" />
    <bpmn:sequenceFlow id="O_f_hecho2" sourceRef="O_hecho" targetRef="O_gw_hoja" />
    <bpmn:sequenceFlow id="O_f4" name="no" sourceRef="O_gw_hecho" targetRef="SP_decidir" />
    <bpmn:sequenceFlow id="O_f_desvio" sourceRef="O_desvio" targetRef="O_aparcar" />
    <bpmn:sequenceFlow id="O_f_desvio2" sourceRef="O_aparcar" targetRef="O_fin_aparcado" />
    <bpmn:sequenceFlow id="O_f5" sourceRef="SP_decidir" targetRef="O_gw_decision" />
    <bpmn:sequenceFlow id="O_f6" name="cerrado con su sí" sourceRef="O_gw_decision" targetRef="O_gw_asiento" />
    <bpmn:sequenceFlow id="O_f_sincerrar" name="sin cerrar" sourceRef="O_gw_decision" targetRef="O_marcar" />
    <bpmn:sequenceFlow id="O_f_marcar2" sourceRef="O_marcar" targetRef="O_gw_hoja" />
    <bpmn:sequenceFlow id="O_f7" name="sí" sourceRef="O_gw_asiento" targetRef="SP_mandar" />
    <bpmn:sequenceFlow id="O_f_propio" name="no" sourceRef="O_gw_asiento" targetRef="O_propio" />
    <bpmn:sequenceFlow id="O_f_propio2" sourceRef="O_propio" targetRef="O_tejer" />
    <bpmn:sequenceFlow id="O_f8" sourceRef="SP_mandar" targetRef="O_verificar" />
    <bpmn:sequenceFlow id="O_f9" sourceRef="O_verificar" targetRef="O_gw_medicion" />
    <bpmn:sequenceFlow id="O_f10" name="sí" sourceRef="O_gw_medicion" targetRef="O_tejer" />
    <bpmn:sequenceFlow id="O_f_devolver" name="no" sourceRef="O_gw_medicion" targetRef="O_devolver" />
    <bpmn:sequenceFlow id="O_f_devolver2" sourceRef="O_devolver" targetRef="SP_mandar" />
