    <bpmn:sequenceFlow id="F_gw4_asentar" name="no" sourceRef="GW_vueltas" targetRef="T_asentar" />
    <bpmn:sequenceFlow id="F_corregir_construir" sourceRef="T_corregir" targetRef="T_construir" />
    <bpmn:sequenceFlow id="F_asentar_auditar" sourceRef="T_asentar" targetRef="T_auditar" />
    <bpmn:sequenceFlow id="F_auditar_marcar" sourceRef="T_auditar" targetRef="T_marcar" />
    <bpmn:sequenceFlow id="F_marcar_guion" sourceRef="T_marcar" targetRef="T_guion" />
    <bpmn:sequenceFlow id="F_guion_fin" sourceRef="T_guion" targetRef="GW_cierre" />
    <bpmn:sequenceFlow id="F_cierre_listo" name="sin pendientes" sourceRef="GW_cierre" targetRef="Fin" />
    <bpmn:sequenceFlow id="F_cierre_huecos" name="con pendientes" sourceRef="GW_cierre" targetRef="Fin_huecos" />
    <bpmn:sequenceFlow id="F_sacar_inventario" sourceRef="T_sacar" targetRef="T_inventariar" />
    <bpmn:sequenceFlow id="F_inventario_vara" sourceRef="T_inventariar" targetRef="T_vara" />
    <bpmn:sequenceFlow id="F_gw2_paro" name="con dudas" sourceRef="GW_construccion" targetRef="Paro_construccion" />
    <bpmn:endEvent id="Paro_construccion" name="Dudas devueltas al experto">
      <bpmn:incoming>F_gw2_paro</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_guion" name="Armar lo que falta preguntar">
      <bpmn:incoming>F_marcar_guion</bpmn:incoming>
      <bpmn:outgoing>F_guion_fin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_cierre">
      <bpmn:incoming>F_guion_fin</bpmn:incoming>
      <bpmn:outgoing>F_cierre_listo</bpmn:outgoing>
      <bpmn:outgoing>F_cierre_huecos</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Fin" name="Paso registrado">
      <bpmn:incoming>F_cierre_listo</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Fin_huecos" name="Paso registrado con huecos">
      <bpmn:incoming>F_cierre_huecos</bpmn:incoming>
    </bpmn:endEvent>
