    <bpmn:sequenceFlow id="F12" name="sin una sola pieza" sourceRef="GW_construir" targetRef="SP_anotar" />
    <bpmn:sequenceFlow id="F26" name="un constructor no contestó" sourceRef="GW_construir" targetRef="SP_anotar" />
    <bpmn:sequenceFlow id="F13" sourceRef="SP_medir" targetRef="T_registrar" />
    <bpmn:sequenceFlow id="F14" sourceRef="T_registrar" targetRef="GW_registrar" />
