<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definiciones_molino" targetNamespace="http://nemawashi/diagramas" exporter="escrito a mano" exporterVersion="4.0">
  <bpmn:collaboration id="Colaboracion_molino">
    <bpmn:participant id="Pool_molino" name="El molino" processRef="Proceso_molino" />
    <bpmn:textAnnotation id="Nota_anotar">
      <bpmn:text>Todo camino que llega al final pasa por aquí. Anotar es medición, no la línea: si falla, se dice y la corrida cierra igual — sin renglón.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Asoc_anotar" sourceRef="SP_anotar" targetRef="Nota_anotar" />
    <bpmn:textAnnotation id="Nota_inventario">
      <bpmn:text>Si el inventario falla, la corrida sigue a ciegas: construir sin él produce duplicados, que se juntan después; no construir no produce nada.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Asoc_inventario" sourceRef="T_inventariar" targetRef="Nota_inventario" />
    <bpmn:textAnnotation id="Nota_examen">
      <bpmn:text>Va antes de construir y no se puede mover: el examen no toca disco, así que el orden de las llamadas es la única garantía.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Asoc_examen" sourceRef="T_examen" targetRef="Nota_examen" />
  </bpmn:collaboration>
  <bpmn:dataStore id="DS_conocimiento" name="El conocimiento ya escrito" isUnlimited="true" />
  <bpmn:process id="Proceso_molino" name="Levantar el conocimiento de un paso" isExecutable="false">
    <bpmn:laneSet id="Carriles">
      <bpmn:lane id="Lane_auditor" name="auditor">
        <bpmn:flowNodeRef>Inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_sacar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_sacar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_inventariar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_examen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_examen_contesto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_examen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_construir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_construir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_medir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_auditar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_marcar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_falta</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_escribano" name="escribano">
        <bpmn:flowNodeRef>T_registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_marcar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_anotar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_cierre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fin_huecos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fin_parada</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Inicio" name="Paso de la sesión cerrado">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:dataStoreReference id="DS_conocimiento_ref" dataStoreRef="DS_conocimiento" name="El conocimiento ya escrito" />
    <bpmn:subProcess id="SP_sacar" name="Sacar lo que dijo el experto">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:startEvent id="S_inicio" name="Grabación de la sesión">
        <bpmn:outgoing>S_f1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="S_platica" name="Sacar la plática y medir la hora">
        <bpmn:incoming>S_f1</bpmn:incoming>
        <bpmn:outgoing>S_f2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="S_gw_contesto" name="¿Contestó el sacador?">
        <bpmn:incoming>S_f2</bpmn:incoming>
        <bpmn:outgoing>S_f3</bpmn:outgoing>
        <bpmn:outgoing>S_f_medicion</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="S_gw_platica" name="¿Vino plática?">
        <bpmn:incoming>S_f3</bpmn:incoming>
        <bpmn:outgoing>S_f4</bpmn:outgoing>
        <bpmn:outgoing>S_f_material</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="S_gw_hora" name="¿La hora trae huso?">
        <bpmn:incoming>S_f4</bpmn:incoming>
        <bpmn:outgoing>S_f5</bpmn:outgoing>
        <bpmn:outgoing>S_f_hora</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="S_gw_ruta" name="¿Llegó ruta de respuestas?">
        <bpmn:incoming>S_f5</bpmn:incoming>
        <bpmn:outgoing>S_f6</bpmn:outgoing>
        <bpmn:outgoing>S_f_primera</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="S_respuestas" name="Leer las respuestas del experto">
        <bpmn:incoming>S_f6</bpmn:incoming>
        <bpmn:outgoing>S_f7</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="S_gw_trajeron" name="¿Trajeron algo?">
        <bpmn:incoming>S_f7</bpmn:incoming>
        <bpmn:outgoing>S_f_segunda</bpmn:outgoing>
        <bpmn:outgoing>S_f_respuestas</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="S_fin_ok" name="Plática y hora en mano">
        <bpmn:incoming>S_f_primera</bpmn:incoming>
        <bpmn:incoming>S_f_segunda</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="S_fin_medicion" name="El sacador no contestó">
        <bpmn:incoming>S_f_medicion</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="S_fin_material" name="Sin material que moler">
        <bpmn:incoming>S_f_material</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="S_fin_hora" name="Sin hora que estampar">
        <bpmn:incoming>S_f_hora</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="S_fin_respuestas" name="Sin las respuestas que se pidieron">
        <bpmn:incoming>S_f_respuestas</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="S_f1" sourceRef="S_inicio" targetRef="S_platica" />
      <bpmn:sequenceFlow id="S_f2" sourceRef="S_platica" targetRef="S_gw_contesto" />
      <bpmn:sequenceFlow id="S_f3" name="sí" sourceRef="S_gw_contesto" targetRef="S_gw_platica" />
      <bpmn:sequenceFlow id="S_f_medicion" name="no" sourceRef="S_gw_contesto" targetRef="S_fin_medicion" />
      <bpmn:sequenceFlow id="S_f4" name="sí" sourceRef="S_gw_platica" targetRef="S_gw_hora" />
      <bpmn:sequenceFlow id="S_f_material" name="no" sourceRef="S_gw_platica" targetRef="S_fin_material" />
      <bpmn:sequenceFlow id="S_f5" name="sí" sourceRef="S_gw_hora" targetRef="S_gw_ruta" />
      <bpmn:sequenceFlow id="S_f_hora" name="no" sourceRef="S_gw_hora" targetRef="S_fin_hora" />
      <bpmn:sequenceFlow id="S_f6" name="sí" sourceRef="S_gw_ruta" targetRef="S_respuestas" />
      <bpmn:sequenceFlow id="S_f_primera" name="no" sourceRef="S_gw_ruta" targetRef="S_fin_ok" />
      <bpmn:sequenceFlow id="S_f7" sourceRef="S_respuestas" targetRef="S_gw_trajeron" />
      <bpmn:sequenceFlow id="S_f_segunda" name="sí" sourceRef="S_gw_trajeron" targetRef="S_fin_ok" />
      <bpmn:sequenceFlow id="S_f_respuestas" name="no" sourceRef="S_gw_trajeron" targetRef="S_fin_respuestas" />
      <bpmn:textAnnotation id="S_nota_hora">
        <bpmn:text>Aquí sí hubo plática: lo que falta es la hora. Sin ella el escribano rechaza entero lo que se muela, y se sabría al final.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="S_asoc_hora" sourceRef="S_fin_hora" targetRef="S_nota_hora" />
      <bpmn:textAnnotation id="S_nota_respuestas">
        <bpmn:text>Que el lector traiga algo dentro es lo que marca la segunda corrida — nunca la ruta por sí sola.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="S_asoc_respuestas" sourceRef="S_gw_trajeron" targetRef="S_nota_respuestas" />
      <bpmn:textAnnotation id="S_nota_paro">
        <bpmn:text>Si las respuestas no se pueden leer, para: degradar a primera corrida haría preguntarle al experto lo que ya contestó.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="S_asoc_paro" sourceRef="S_fin_respuestas" targetRef="S_nota_paro" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="GW_sacar">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_inventariar" name="Inventariar lo ya escrito">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:dataInputAssociation id="DA_conocimiento">
        <bpmn:sourceRef>DS_conocimiento_ref</bpmn:sourceRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="T_examen" name="Levantar el examen">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_examen_contesto" name="¿Contestó?">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F6b</bpmn:outgoing>
      <bpmn:outgoing>F27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_examen" name="¿Quedó alguna pregunta?">
      <bpmn:incoming>F6b</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SP_construir" name="Construir el registro">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
      <bpmn:startEvent id="C_inicio" name="Preguntas levantadas">
        <bpmn:outgoing>C_f1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="C_reglas" name="Sacar las reglas dichas">
        <bpmn:incoming>C_f1</bpmn:incoming>
        <bpmn:outgoing>C_f2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="C_gw_r" name="¿Contestó?">
        <bpmn:incoming>C_f2</bpmn:incoming>
        <bpmn:outgoing>C_f3</bpmn:outgoing>
        <bpmn:outgoing>C_f_sin1</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="C_capacidades" name="Proponer las capacidades">
        <bpmn:incoming>C_f3</bpmn:incoming>
        <bpmn:outgoing>C_f4</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="C_gw_c" name="¿Contestó?">
        <bpmn:incoming>C_f4</bpmn:incoming>
        <bpmn:outgoing>C_f5</bpmn:outgoing>
        <bpmn:outgoing>C_f_sin2</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="C_modulos" name="Proponer los módulos">
        <bpmn:incoming>C_f5</bpmn:incoming>
        <bpmn:outgoing>C_f6</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="C_gw_m" name="¿Contestó?">
        <bpmn:incoming>C_f6</bpmn:incoming>
        <bpmn:outgoing>C_f7</bpmn:outgoing>
        <bpmn:outgoing>C_f_sin3</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="C_dominios" name="Proponer los dominios">
        <bpmn:incoming>C_f7</bpmn:incoming>
        <bpmn:outgoing>C_f8</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="C_gw_d" name="¿Contestó?">
        <bpmn:incoming>C_f8</bpmn:incoming>
        <bpmn:outgoing>C_f9</bpmn:outgoing>
        <bpmn:outgoing>C_f_sin4</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="C_gw_dudas" name="¿Quedaron dudas?">
        <bpmn:incoming>C_f9</bpmn:incoming>
        <bpmn:outgoing>C_f10</bpmn:outgoing>
        <bpmn:outgoing>C_f11</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="C_gw_primera" name="¿Es la primera corrida?">
        <bpmn:incoming>C_f10</bpmn:incoming>
        <bpmn:outgoing>C_f12</bpmn:outgoing>
        <bpmn:outgoing>C_f13</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="C_gw_piezas" name="¿Salió alguna pieza?">
        <bpmn:incoming>C_f11</bpmn:incoming>
        <bpmn:incoming>C_f13</bpmn:incoming>
        <bpmn:outgoing>C_f14</bpmn:outgoing>
        <bpmn:outgoing>C_f15</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="C_fin_ok" name="Registro construido">
        <bpmn:incoming>C_f14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="C_fin_dudas" name="Dudas devueltas al experto">
        <bpmn:incoming>C_f12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="C_fin_vacio" name="Sin una sola pieza">
        <bpmn:incoming>C_f15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="C_fin_sin" name="Un constructor no contestó">
        <bpmn:incoming>C_f_sin1</bpmn:incoming>
        <bpmn:incoming>C_f_sin2</bpmn:incoming>
        <bpmn:incoming>C_f_sin3</bpmn:incoming>
        <bpmn:incoming>C_f_sin4</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="C_f1" sourceRef="C_inicio" targetRef="C_reglas" />
      <bpmn:sequenceFlow id="C_f2" sourceRef="C_reglas" targetRef="C_gw_r" />
      <bpmn:sequenceFlow id="C_f3" name="sí" sourceRef="C_gw_r" targetRef="C_capacidades" />
      <bpmn:sequenceFlow id="C_f_sin1" name="no" sourceRef="C_gw_r" targetRef="C_fin_sin" />
      <bpmn:sequenceFlow id="C_f4" sourceRef="C_capacidades" targetRef="C_gw_c" />
      <bpmn:sequenceFlow id="C_f5" name="sí" sourceRef="C_gw_c" targetRef="C_modulos" />
      <bpmn:sequenceFlow id="C_f_sin2" name="no" sourceRef="C_gw_c" targetRef="C_fin_sin" />
      <bpmn:sequenceFlow id="C_f6" sourceRef="C_modulos" targetRef="C_gw_m" />
      <bpmn:sequenceFlow id="C_f7" name="sí" sourceRef="C_gw_m" targetRef="C_dominios" />
      <bpmn:sequenceFlow id="C_f_sin3" name="no" sourceRef="C_gw_m" targetRef="C_fin_sin" />
      <bpmn:sequenceFlow id="C_f8" sourceRef="C_dominios" targetRef="C_gw_d" />
      <bpmn:sequenceFlow id="C_f9" name="sí" sourceRef="C_gw_d" targetRef="C_gw_dudas" />
      <bpmn:sequenceFlow id="C_f_sin4" name="no" sourceRef="C_gw_d" targetRef="C_fin_sin" />
      <bpmn:sequenceFlow id="C_f10" name="sí" sourceRef="C_gw_dudas" targetRef="C_gw_primera" />
      <bpmn:sequenceFlow id="C_f11" name="no" sourceRef="C_gw_dudas" targetRef="C_gw_piezas" />
      <bpmn:sequenceFlow id="C_f12" name="sí" sourceRef="C_gw_primera" targetRef="C_fin_dudas" />
      <bpmn:sequenceFlow id="C_f13" name="no" sourceRef="C_gw_primera" targetRef="C_gw_piezas" />
      <bpmn:sequenceFlow id="C_f14" name="sí" sourceRef="C_gw_piezas" targetRef="C_fin_ok" />
      <bpmn:sequenceFlow id="C_f15" name="no" sourceRef="C_gw_piezas" targetRef="C_fin_vacio" />
      <bpmn:textAnnotation id="C_nota_cadena">
        <bpmn:text>En cadena y sin paralelizar: cada una cita lo que construyó la anterior, y en cuanto nace el tipo de arriba el código le cose a la pieza de abajo el enlace que apunta a quien la contiene.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="C_asoc_cadena" sourceRef="C_capacidades" targetRef="C_nota_cadena" />
      <bpmn:textAnnotation id="C_nota_orden">
        <bpmn:text>Las dudas cortan antes que el registro vacío: con dudas y cero piezas, la corrida se va por las dudas.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="C_asoc_orden" sourceRef="C_gw_dudas" targetRef="C_nota_orden" />
      <bpmn:textAnnotation id="C_nota_primera">
        <bpmn:text>El experto contesta una sola corrida. En la segunda, lo que siga sin cerrar se registra como hueco: un freno que no se levanta es candado.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="C_asoc_primera" sourceRef="C_gw_primera" targetRef="C_nota_primera" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="GW_construir">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:outgoing>F26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SP_medir" name="Medir y corregir">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
      <bpmn:dataObjectReference id="DO_dicho_ref" dataObjectRef="DO_dicho" name="Lo que dijo el experto" />
      <bpmn:dataObject id="DO_dicho" />
      <bpmn:dataObjectReference id="DO_examen_ref" dataObjectRef="DO_examen" name="El examen" />
      <bpmn:dataObject id="DO_examen" isCollection="true" />
      <bpmn:startEvent id="M_inicio" name="Registro construido">
        <bpmn:outgoing>M_f1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:parallelGateway id="M_abre">
        <bpmn:incoming>M_f1</bpmn:incoming>
        <bpmn:outgoing>M_f_frio</bpmn:outgoing>
        <bpmn:outgoing>M_f_cotejar</bpmn:outgoing>
        <bpmn:outgoing>M_f_examen</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:task id="M_frio" name="Leer el registro en frío">
        <bpmn:incoming>M_f_frio</bpmn:incoming>
        <bpmn:outgoing>M_f_frio2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="M_cotejar" name="Cotejar lo dicho">
        <bpmn:incoming>M_f_cotejar</bpmn:incoming>
        <bpmn:outgoing>M_f_cotejar2</bpmn:outgoing>
        <bpmn:dataInputAssociation id="DA_dicho">
          <bpmn:sourceRef>DO_dicho_ref</bpmn:sourceRef>
        </bpmn:dataInputAssociation>
      </bpmn:task>
      <bpmn:task id="M_contestar" name="Contestar el examen">
        <bpmn:incoming>M_f_examen</bpmn:incoming>
        <bpmn:outgoing>M_f_examen2</bpmn:outgoing>
        <bpmn:dataInputAssociation id="DA_examen">
          <bpmn:sourceRef>DO_examen_ref</bpmn:sourceRef>
        </bpmn:dataInputAssociation>
      </bpmn:task>
      <bpmn:parallelGateway id="M_cierra">
        <bpmn:incoming>M_f_frio2</bpmn:incoming>
        <bpmn:incoming>M_f_cotejar2</bpmn:incoming>
        <bpmn:incoming>M_f_examen2</bpmn:incoming>
        <bpmn:outgoing>M_f2</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:exclusiveGateway id="M_gw" name="¿Marcaron algo las tres?">
        <bpmn:incoming>M_f2</bpmn:incoming>
        <bpmn:outgoing>M_f3</bpmn:outgoing>
        <bpmn:outgoing>M_f_limpia</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="M_corregir1" name="Corregir lo que marcaron las tres">
        <bpmn:incoming>M_f3</bpmn:incoming>
        <bpmn:outgoing>M_f4</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      </bpmn:task>
      <bpmn:exclusiveGateway id="M_gw_corrigio1" name="¿Contestó algún corrector?">
        <bpmn:incoming>M_f4</bpmn:incoming>
        <bpmn:outgoing>M_f5</bpmn:outgoing>
        <bpmn:outgoing>M_f_sin1</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="M_remedir" name="Volver a medir las tres">
        <bpmn:incoming>M_f5</bpmn:incoming>
        <bpmn:outgoing>M_f6</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="M_gw_inventos" name="¿El cotejo sigue marcando inventos?">
        <bpmn:incoming>M_f6</bpmn:incoming>
        <bpmn:outgoing>M_f7</bpmn:outgoing>
        <bpmn:outgoing>M_f_sin2</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="M_corregir2" name="Corregir los inventos que quedan">
        <bpmn:incoming>M_f7</bpmn:incoming>
        <bpmn:outgoing>M_f8</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      </bpmn:task>
      <bpmn:exclusiveGateway id="M_gw_corrigio2" name="¿Contestó algún corrector?">
        <bpmn:incoming>M_f8</bpmn:incoming>
        <bpmn:outgoing>M_f9</bpmn:outgoing>
        <bpmn:outgoing>M_f_sin3</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="M_recotejar" name="Cotejar otra vez">
        <bpmn:incoming>M_f9</bpmn:incoming>
        <bpmn:outgoing>M_f10</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="M_fin" name="Registro medido">
        <bpmn:incoming>M_f_limpia</bpmn:incoming>
        <bpmn:incoming>M_f_sin1</bpmn:incoming>
        <bpmn:incoming>M_f_sin2</bpmn:incoming>
        <bpmn:incoming>M_f_sin3</bpmn:incoming>
        <bpmn:incoming>M_f10</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="M_f1" sourceRef="M_inicio" targetRef="M_abre" />
      <bpmn:sequenceFlow id="M_f_frio" sourceRef="M_abre" targetRef="M_frio" />
      <bpmn:sequenceFlow id="M_f_cotejar" sourceRef="M_abre" targetRef="M_cotejar" />
      <bpmn:sequenceFlow id="M_f_examen" sourceRef="M_abre" targetRef="M_contestar" />
      <bpmn:sequenceFlow id="M_f_frio2" sourceRef="M_frio" targetRef="M_cierra" />
      <bpmn:sequenceFlow id="M_f_cotejar2" sourceRef="M_cotejar" targetRef="M_cierra" />
      <bpmn:sequenceFlow id="M_f_examen2" sourceRef="M_contestar" targetRef="M_cierra" />
      <bpmn:sequenceFlow id="M_f2" sourceRef="M_cierra" targetRef="M_gw" />
      <bpmn:sequenceFlow id="M_f_limpia" name="no" sourceRef="M_gw" targetRef="M_fin" />
      <bpmn:sequenceFlow id="M_f3" name="sí" sourceRef="M_gw" targetRef="M_corregir1" />
      <bpmn:sequenceFlow id="M_f4" sourceRef="M_corregir1" targetRef="M_gw_corrigio1" />
      <bpmn:sequenceFlow id="M_f5" name="sí" sourceRef="M_gw_corrigio1" targetRef="M_remedir" />
      <bpmn:sequenceFlow id="M_f_sin1" name="no" sourceRef="M_gw_corrigio1" targetRef="M_fin" />
      <bpmn:sequenceFlow id="M_f6" sourceRef="M_remedir" targetRef="M_gw_inventos" />
      <bpmn:sequenceFlow id="M_f7" name="sí" sourceRef="M_gw_inventos" targetRef="M_corregir2" />
      <bpmn:sequenceFlow id="M_f_sin2" name="no" sourceRef="M_gw_inventos" targetRef="M_fin" />
      <bpmn:sequenceFlow id="M_f8" sourceRef="M_corregir2" targetRef="M_gw_corrigio2" />
      <bpmn:sequenceFlow id="M_f9" name="sí" sourceRef="M_gw_corrigio2" targetRef="M_recotejar" />
      <bpmn:sequenceFlow id="M_f_sin3" name="no" sourceRef="M_gw_corrigio2" targetRef="M_fin" />
      <bpmn:sequenceFlow id="M_f10" sourceRef="M_recotejar" targetRef="M_fin" />
      <bpmn:textAnnotation id="M_nota_tres">
        <bpmn:text>Las tres son independientes: corren juntas y se espera a las tres.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="M_asoc_tres" sourceRef="M_abre" targetRef="M_nota_tres" />
      <bpmn:textAnnotation id="M_nota_corregir">
        <bpmn:text>Una llamada por tipo de pieza, en fila, y se salta los tipos que nadie marcó. Basta con que una conteste para volver a medir: nadie comprueba que haya cambiado algo.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="M_asoc_corregir" sourceRef="M_corregir1" targetRef="M_nota_corregir" />
      <bpmn:textAnnotation id="M_nota_segunda">
        <bpmn:text>La segunda vuelta va sólo por lo que el cotejador siga marcando: lo que no se entiende solo y lo que el examen no contesta se cierran con el experto después.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="M_asoc_segunda" sourceRef="M_gw_inventos" targetRef="M_nota_segunda" />
    </bpmn:subProcess>
    <bpmn:task id="T_registrar" name="Registrar los archivos">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_registrar" name="¿Contestó el escribano?">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_auditar" name="Auditar lo escrito">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_marcar" name="¿El dictamen trae fallas o dice que no sirve?">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_marcar" name="Marcar lo que el auditor encontró">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_falta" name="Armar lo que falta preguntar">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:subProcess id="SP_anotar" name="Anotar la corrida">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:incoming>F26</bpmn:incoming>
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
      <bpmn:startEvent id="N_inicio" name="Corrida terminada o parada">
        <bpmn:outgoing>N_f1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="N_hora" name="Medir la hora de cierre">
        <bpmn:incoming>N_f1</bpmn:incoming>
        <bpmn:outgoing>N_f2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="N_renglon" name="Escribir el renglón de la corrida">
        <bpmn:incoming>N_f2</bpmn:incoming>
        <bpmn:outgoing>N_f3</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="N_gw" name="¿Quedó escrito el renglón?">
        <bpmn:incoming>N_f3</bpmn:incoming>
        <bpmn:outgoing>N_f4</bpmn:outgoing>
        <bpmn:outgoing>N_f5</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="N_fin" name="Renglón anotado">
        <bpmn:incoming>N_f4</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="N_fin_sin" name="Sin renglón, y dicho en el log">
        <bpmn:incoming>N_f5</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="N_f1" sourceRef="N_inicio" targetRef="N_hora" />
      <bpmn:sequenceFlow id="N_f2" sourceRef="N_hora" targetRef="N_renglon" />
      <bpmn:sequenceFlow id="N_f3" sourceRef="N_renglon" targetRef="N_gw" />
      <bpmn:sequenceFlow id="N_f4" name="sí" sourceRef="N_gw" targetRef="N_fin" />
      <bpmn:sequenceFlow id="N_f5" name="no" sourceRef="N_gw" targetRef="N_fin_sin" />
      <bpmn:textAnnotation id="N_nota_dos">
        <bpmn:text>Dos puestos, no uno: la hora de cierre la mide un auditor y el renglón lo escribe el escribano. Ninguno carga carta — las dos llamadas son mecánicas.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="N_asoc_dos" sourceRef="N_hora" targetRef="N_nota_dos" />
      <bpmn:textAnnotation id="N_nota_hora">
        <bpmn:text>Si la hora de cierre no llega, no para nada: el renglón sale sin duración.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="N_asoc_hora" sourceRef="N_hora" targetRef="N_nota_hora" />
      <bpmn:textAnnotation id="N_nota_estado">
        <bpmn:text>Las dos llamadas van envueltas para que no tumben la corrida: si truenan, se dice y se sigue. Y el estado llega decidido desde el punto por donde salió: aquí no se calcula.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="N_asoc_estado" sourceRef="N_gw" targetRef="N_nota_estado" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="GW_cierre" name="¿Con qué estado se anotó?">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
      <bpmn:outgoing>F24</bpmn:outgoing>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Fin" name="Paso registrado">
      <bpmn:incoming>F23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Fin_huecos" name="Paso registrado con huecos">
      <bpmn:incoming>F24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Fin_parada" name="Corrida parada, con su renglón">
      <bpmn:incoming>F25</bpmn:incoming>
    </bpmn:endEvent>
