        <di:waypoint x="910" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_A_f_perdido" bpmnElement="A_f_perdido">
        <di:waypoint x="860" y="240" />
        <di:waypoint x="910" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_A_f_marcado" bpmnElement="A_f_marcado">
        <di:waypoint x="835" y="265" />
        <di:waypoint x="835" y="360" />
        <di:waypoint x="910" y="360" />
