      <bpmndi:BPMNShape id="S_A_abrir" bpmnElement="A_abrir">
        <dc:Bounds x="660" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_A_abre_par" bpmnElement="A_abre_par">
        <dc:Bounds x="810" y="215" width="50" height="50" />
      </bpmndi:BPMNShape>
