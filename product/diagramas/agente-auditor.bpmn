<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definiciones_auditor" targetNamespace="http://nemawashi/diagramas" exporter="escrito a mano" exporterVersion="1.0">
  <bpmn:process id="Proceso_auditor_auditar" name="Auditar lo escrito contra el crudo" isExecutable="false">
    <bpmn:startEvent id="A_inicio" name="Algo ya escrito">
      <bpmn:outgoing>A_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="A_gw_donde" name="¿Te dijeron dónde se escribió?">
      <bpmn:incoming>A_f1</bpmn:incoming>
      <bpmn:outgoing>A_f2</bpmn:outgoing>
      <bpmn:outgoing>A_f_donde</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="A_fin_donde" name="Pregunta devuelta antes de abrir nada">
      <bpmn:incoming>A_f_donde</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="A_crudo" name="Leer el registro crudo">
      <bpmn:incoming>A_f2</bpmn:incoming>
      <bpmn:outgoing>A_f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="A_gw_completo" name="¿Está completo el crudo?">
      <bpmn:incoming>A_f3</bpmn:incoming>
      <bpmn:outgoing>A_f4</bpmn:outgoing>
      <bpmn:outgoing>A_f_declarar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="A_declarar" name="Declarar qué no se va a poder medir">
      <bpmn:incoming>A_f_declarar</bpmn:incoming>
      <bpmn:outgoing>A_f_declarar2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A_abrir" name="Abrir lo escrito">
      <bpmn:incoming>A_f4</bpmn:incoming>
      <bpmn:incoming>A_f_declarar2</bpmn:incoming>
      <bpmn:outgoing>A_f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="A_abre_par">
      <bpmn:incoming>A_f5</bpmn:incoming>
      <bpmn:outgoing>A_f_inventado</bpmn:outgoing>
      <bpmn:outgoing>A_f_perdido</bpmn:outgoing>
      <bpmn:outgoing>A_f_marcado</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="A_inventado" name="Buscar lo escrito que nadie dijo">
      <bpmn:incoming>A_f_inventado</bpmn:incoming>
      <bpmn:outgoing>A_f_inventado2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A_perdido" name="Buscar lo dicho que no quedó escrito">
      <bpmn:incoming>A_f_perdido</bpmn:incoming>
      <bpmn:outgoing>A_f_perdido2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="A_marcado" name="Comprobar la firmeza y los enlaces">
      <bpmn:incoming>A_f_marcado</bpmn:incoming>
      <bpmn:outgoing>A_f_marcado2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="A_cierra_par">
      <bpmn:incoming>A_f_inventado2</bpmn:incoming>
      <bpmn:incoming>A_f_perdido2</bpmn:incoming>
      <bpmn:incoming>A_f_marcado2</bpmn:incoming>
      <bpmn:outgoing>A_f6</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="A_frio" name="Leerlo como el que no estuvo">
      <bpmn:incoming>A_f6</bpmn:incoming>
      <bpmn:outgoing>A_f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="A_fin" name="Dictamen con su prueba">
      <bpmn:incoming>A_f7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="A_f1" sourceRef="A_inicio" targetRef="A_gw_donde" />
    <bpmn:sequenceFlow id="A_f2" name="sí" sourceRef="A_gw_donde" targetRef="A_crudo" />
    <bpmn:sequenceFlow id="A_f_donde" name="no" sourceRef="A_gw_donde" targetRef="A_fin_donde" />
    <bpmn:sequenceFlow id="A_f3" sourceRef="A_crudo" targetRef="A_gw_completo" />
    <bpmn:sequenceFlow id="A_f4" name="sí" sourceRef="A_gw_completo" targetRef="A_abrir" />
    <bpmn:sequenceFlow id="A_f_declarar" name="no" sourceRef="A_gw_completo" targetRef="A_declarar" />
    <bpmn:sequenceFlow id="A_f_declarar2" sourceRef="A_declarar" targetRef="A_abrir" />
    <bpmn:sequenceFlow id="A_f5" sourceRef="A_abrir" targetRef="A_abre_par" />
    <bpmn:sequenceFlow id="A_f_inventado" sourceRef="A_abre_par" targetRef="A_inventado" />
    <bpmn:sequenceFlow id="A_f_perdido" sourceRef="A_abre_par" targetRef="A_perdido" />
    <bpmn:sequenceFlow id="A_f_marcado" sourceRef="A_abre_par" targetRef="A_marcado" />
    <bpmn:sequenceFlow id="A_f_inventado2" sourceRef="A_inventado" targetRef="A_cierra_par" />
    <bpmn:sequenceFlow id="A_f_perdido2" sourceRef="A_perdido" targetRef="A_cierra_par" />
    <bpmn:sequenceFlow id="A_f_marcado2" sourceRef="A_marcado" targetRef="A_cierra_par" />
    <bpmn:sequenceFlow id="A_f6" sourceRef="A_cierra_par" targetRef="A_frio" />
    <bpmn:sequenceFlow id="A_f7" sourceRef="A_frio" targetRef="A_fin" />
    <bpmn:textAnnotation id="A_nota_orden">
      <bpmn:text>Primero el crudo, después lo escrito, y no se invierte. Al revés no se audita: se confirma.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="A_asoc_orden" sourceRef="A_crudo" targetRef="A_nota_orden" />
    <bpmn:textAnnotation id="A_nota_completo">
      <bpmn:text>El crudo son dos cosas: la grabación y lo que el experto contestó después, que no está en ella.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="A_asoc_completo" sourceRef="A_gw_completo" targetRef="A_nota_completo" />
    <bpmn:textAnnotation id="A_nota_frio">
      <bpmn:text>La cuarta falla va después de las otras tres: ¿le alcanza a alguien que no estuvo?</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="A_asoc_frio" sourceRef="A_frio" targetRef="A_nota_frio" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="A_diagrama">
    <bpmndi:BPMNPlane id="A_plano" bpmnElement="Proceso_auditor_auditar">
      <bpmndi:BPMNShape id="S_A_inicio" bpmnElement="A_inicio">
        <dc:Bounds x="160" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="140" y="265" width="78" height="14" />
