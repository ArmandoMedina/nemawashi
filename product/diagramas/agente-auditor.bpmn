      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_A_f5" bpmnElement="A_f5">
        <di:waypoint x="760" y="240" />
        <di:waypoint x="810" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_A_f_inventado" bpmnElement="A_f_inventado">
        <di:waypoint x="835" y="215" />
