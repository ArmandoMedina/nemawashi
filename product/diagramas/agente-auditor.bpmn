        <bpmndi:BPMNLabel>
          <dc:Bounds x="285" y="168" width="13" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_A_f3" bpmnElement="A_f3">
        <di:waypoint x="450" y="240" />
        <di:waypoint x="500" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_A_f4" bpmnElement="A_f4">
