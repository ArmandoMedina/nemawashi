      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_A_marcado" bpmnElement="A_marcado">
        <dc:Bounds x="910" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_A_cierra_par" bpmnElement="A_cierra_par">
        <dc:Bounds x="1060" y="215" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_A_frio" bpmnElement="A_frio">
        <dc:Bounds x="1160" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_A_fin" bpmnElement="A_fin">
        <dc:Bounds x="1320" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1295" y="265" width="87" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_A_nota_orden" bpmnElement="A_nota_orden">
        <dc:Bounds x="320" y="480" width="190" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_A_nota_completo" bpmnElement="A_nota_completo">
        <dc:Bounds x="560" y="480" width="190" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_A_nota_frio" bpmnElement="A_nota_frio">
        <dc:Bounds x="1080" y="480" width="190" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_A_f1" bpmnElement="A_f1">
