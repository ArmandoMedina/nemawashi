      <bpmndi:BPMNEdge id="E_A_f_inventado2" bpmnElement="A_f_inventado2">
        <di:waypoint x="1010" y="120" />
        <di:waypoint x="1085" y="120" />
        <di:waypoint x="1085" y="215" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_A_f_perdido2" bpmnElement="A_f_perdido2">
