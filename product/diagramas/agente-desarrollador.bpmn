<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definiciones_desarrollador" targetNamespace="http://nemawashi/diagramas" exporter="escrito a mano" exporterVersion="1.0">
  <bpmn:process id="Proceso_desarrollador" name="Implementar con la prueba en el mismo cambio" isExecutable="false">
    <bpmn:startEvent id="D_inicio" name="Encargo recibido">
      <bpmn:outgoing>D_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="D_arquitectura" name="Leer la arquitectura ya decidida">
      <bpmn:incoming>D_f1</bpmn:incoming>
      <bpmn:outgoing>D_f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="D_gw_decidido" name="¿La pieza está decidida?">
      <bpmn:incoming>D_f2</bpmn:incoming>
      <bpmn:outgoing>D_f3</bpmn:outgoing>
      <bpmn:outgoing>D_f_pregunta</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="D_fin_pregunta" name="Pregunta devuelta a quien decide">
      <bpmn:incoming>D_f_pregunta</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="D_clasificar" name="Clasificar la prueba en las cinco capas">
      <bpmn:incoming>D_f3</bpmn:incoming>
      <bpmn:outgoing>D_f4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="D_roja" name="Escribir la prueba que falla">
      <bpmn:incoming>D_f4</bpmn:incoming>
      <bpmn:incoming>D_f_rehacer</bpmn:incoming>
      <bpmn:outgoing>D_f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="D_gw_razon" name="¿Falla por la razón correcta?">
      <bpmn:incoming>D_f5</bpmn:incoming>
      <bpmn:outgoing>D_f6</bpmn:outgoing>
      <bpmn:outgoing>D_f_rehacer</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="D_verde" name="Escribir el mínimo código para verde">
      <bpmn:incoming>D_f6</bpmn:incoming>
      <bpmn:incoming>D_f_corregir</bpmn:incoming>
      <bpmn:outgoing>D_f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="D_bordes" name="Cubrir los bordes">
      <bpmn:incoming>D_f7</bpmn:incoming>
      <bpmn:outgoing>D_f8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="D_suite" name="Correr la suite de cierre">
      <bpmn:incoming>D_f8</bpmn:incoming>
      <bpmn:outgoing>D_f9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="D_gw_verde" name="¿Pasó entera?">
      <bpmn:incoming>D_f9</bpmn:incoming>
      <bpmn:outgoing>D_f10</bpmn:outgoing>
      <bpmn:outgoing>D_f_corregir</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="D_fin" name="Cambio con su prueba en verde">
      <bpmn:incoming>D_f10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="D_f1" sourceRef="D_inicio" targetRef="D_arquitectura" />
    <bpmn:sequenceFlow id="D_f2" sourceRef="D_arquitectura" targetRef="D_gw_decidido" />
    <bpmn:sequenceFlow id="D_f3" name="sí" sourceRef="D_gw_decidido" targetRef="D_clasificar" />
    <bpmn:sequenceFlow id="D_f_pregunta" name="no" sourceRef="D_gw_decidido" targetRef="D_fin_pregunta" />
    <bpmn:sequenceFlow id="D_f4" sourceRef="D_clasificar" targetRef="D_roja" />
    <bpmn:sequenceFlow id="D_f5" sourceRef="D_roja" targetRef="D_gw_razon" />
    <bpmn:sequenceFlow id="D_f6" name="sí" sourceRef="D_gw_razon" targetRef="D_verde" />
    <bpmn:sequenceFlow id="D_f_rehacer" name="no" sourceRef="D_gw_razon" targetRef="D_roja" />
    <bpmn:sequenceFlow id="D_f7" sourceRef="D_verde" targetRef="D_bordes" />
    <bpmn:sequenceFlow id="D_f8" sourceRef="D_bordes" targetRef="D_suite" />
    <bpmn:sequenceFlow id="D_f9" sourceRef="D_suite" targetRef="D_gw_verde" />
    <bpmn:sequenceFlow id="D_f10" name="sí" sourceRef="D_gw_verde" targetRef="D_fin" />
    <bpmn:sequenceFlow id="D_f_corregir" name="no" sourceRef="D_gw_verde" targetRef="D_verde" />
    <bpmn:textAnnotation id="D_nota_razon">
      <bpmn:text>Un rojo por un import roto no es rojo: la prueba tiene que fallar por lo que el código va a arreglar.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="D_asoc_razon" sourceRef="D_gw_razon" targetRef="D_nota_razon" />
    <bpmn:textAnnotation id="D_nota_suite">
      <bpmn:text>La suite de cierre no se sustituye: un comando inventado que sale verde es el defecto más caro de este oficio.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="D_asoc_suite" sourceRef="D_suite" targetRef="D_nota_suite" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D_diagrama">
    <bpmndi:BPMNPlane id="D_plano" bpmnElement="Proceso_desarrollador">
      <bpmndi:BPMNShape id="S_D_inicio" bpmnElement="D_inicio">
        <dc:Bounds x="160" y="122" width="36" height="36" />
