      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_D_bordes" bpmnElement="D_bordes">
        <dc:Bounds x="1050" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_D_suite" bpmnElement="D_suite">
        <dc:Bounds x="1200" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_D_gw_verde" bpmnElement="D_gw_verde" isMarkerVisible="true">
        <dc:Bounds x="1350" y="115" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1345" y="72" width="61" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_D_fin" bpmnElement="D_fin">
        <dc:Bounds x="1462" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1437" y="165" width="87" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_D_nota_razon" bpmnElement="D_nota_razon">
        <dc:Bounds x="700" y="370" width="190" height="60" />
      </bpmndi:BPMNShape>
