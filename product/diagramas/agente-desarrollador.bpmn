      <bpmndi:BPMNShape id="S_D_gw_razon" bpmnElement="D_gw_razon" isMarkerVisible="true">
        <dc:Bounds x="800" y="115" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="785" y="72" width="82" height="27" />
