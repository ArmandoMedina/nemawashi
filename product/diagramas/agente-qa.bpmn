        <di:waypoint x="975" y="115" />
        <di:waypoint x="975" y="60" />
        <di:waypoint x="700" y="60" />
        <di:waypoint x="700" y="100" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="985" y="75" width="13" height="14" />
        </bpmndi:BPMNLabel>
