      <bpmndi:BPMNShape id="S_Q_gw_roja" bpmnElement="Q_gw_roja" isMarkerVisible="true">
        <dc:Bounds x="950" y="115" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="940" y="72" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Q_correr" bpmnElement="Q_correr">
        <dc:Bounds x="1050" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Q_gw_paso" bpmnElement="Q_gw_paso" isMarkerVisible="true">
        <dc:Bounds x="1200" y="115" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1195" y="72" width="61" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Q_fin" bpmnElement="Q_fin">
        <dc:Bounds x="1312" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1287" y="165" width="87" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Q_fin_rojo" bpmnElement="Q_fin_rojo">
        <dc:Bounds x="1207" y="252" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1182" y="295" width="87" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Q_nota_clasificar" bpmnElement="Q_nota_clasificar">
        <dc:Bounds x="240" y="420" width="190" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Q_nota_romper" bpmnElement="Q_nota_romper">
        <dc:Bounds x="720" y="420" width="200" height="60" />
      </bpmndi:BPMNShape>
