<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_consultor" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.22.0">
  <bpmn:collaboration id="Colaboracion_consultor">
    <bpmn:participant id="Pool_consultor" name="La sesión con el experto" processRef="Proceso_consultor" />
    <bpmn:textAnnotation id="Nota_moler">
      <bpmn:text>Es la herramienta `Workflow` con `name: levanta-el-conocimiento`. No es una carta y por ahí no arranca. La plática no se le teclea: lee sola la grabación de esta misma sesión. Su interior está dibujado aparte, en `levanta-el-conocimiento.bpmn`.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Nota_anunciar">
      <bpmn:text>Se dice en voz alta: «de crédito ya saqué bastante, vámonos a la cobranza». Y se muele ahí mismo, antes de la primera pregunta del paso siguiente.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Nota_guardar">
      <bpmn:text>Si el experto pide guardar, se muele aunque estén a media rama. Los dos eventos interrumpen: al volver, el paso se excava desde el principio — se vuelve a pedir un caso y la cuenta de preguntas sin hallazgo arranca de cero.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Nota_pasos">
      <bpmn:text>Un paso no se da por cerrado hasta que se molió: lo que se queda en la plática se pierde. Por eso el molido está en el tronco y no al final de la sesión.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Nota_cierre">
      <bpmn:text>La lista se muestra completa cada cuatro o cinco intercambios, y otra vez al cerrar. No se cierra con hallazgos sin registrar.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Nota_preguntas_molino">
      <bpmn:text>Las preguntas que devuelve el molino no las contesta el consultor. Para eso está el experto enfrente, y en dos semanas ya no va a estar.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Asoc_guardar" sourceRef="C_guardar" targetRef="Nota_guardar" />
    <bpmn:association id="Asoc_anunciar" sourceRef="C_anunciar" targetRef="Nota_anunciar" />
    <bpmn:association id="Asoc_cierre" sourceRef="C_lista" targetRef="Nota_cierre" />
    <bpmn:association id="Asoc_pasos" sourceRef="C_gw_pasos" targetRef="Nota_pasos" />
    <bpmn:association id="Asoc_preguntas_molino" sourceRef="C_preguntas" targetRef="Nota_preguntas_molino" />
    <bpmn:association id="Asoc_moler" sourceRef="C_moler" targetRef="Nota_moler" />
  </bpmn:collaboration>
  <bpmn:process id="Proceso_consultor" name="Conducir a un experto de negocio" isExecutable="false">
    <bpmn:laneSet id="Carriles_consultor">
      <bpmn:lane id="Lane_molino" name="el molino">
        <bpmn:flowNodeRef>C_moler</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_consultor" name="consultor">
        <bpmn:flowNodeRef>C_inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_tiempo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_guardar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_sintocar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_anunciar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_gw_molino</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_nada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_contar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_gw_pasos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_lista</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_gw_fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_faltaron</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_fin_huecos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_acotar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_excavar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>C_preguntas</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:dataObjectReference id="DO_mapa_ref" name="El mapa y la vara" dataObjectRef="DO_mapa" />
    <bpmn:dataObject id="DO_mapa" />
    <bpmn:startEvent id="C_inicio" name="Llega el experto">
      <bpmn:outgoing>C_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:boundaryEvent id="C_tiempo" name="Se acabó el tiempo" attachedToRef="C_excavar">
      <bpmn:outgoing>C_f_tiempo</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_10wuyxr" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="C_guardar" name="El experto pide guardar" attachedToRef="C_excavar">
      <bpmn:outgoing>C_f_guardar</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0z131e0" />
    </bpmn:boundaryEvent>
    <bpmn:dataObjectReference id="DO_hallazgos_ref" name="La lista de hallazgos" dataObjectRef="DO_hallazgos" />
    <bpmn:dataObject id="DO_hallazgos" isCollection="true" />
    <bpmn:subProcess id="C_acotar" name="Acotar el terreno">
      <bpmn:incoming>C_f1</bpmn:incoming>
      <bpmn:outgoing>C_f2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA_mapa_out">
        <bpmn:targetRef>DO_mapa_ref</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:startEvent id="H0_inicio" name="El experto llega con su tema">
        <bpmn:outgoing>H0_f1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="H0_gw" name="¿Lo que trae ya opera?">
        <bpmn:incoming>H0_f1</bpmn:incoming>
        <bpmn:outgoing>H0_f_si</bpmn:outgoing>
        <bpmn:outgoing>H0_f_no</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="H0_mapa" name="Pedir el proceso en tres a seis pasos">
        <bpmn:incoming>H0_f_si</bpmn:incoming>
        <bpmn:outgoing>H0_f2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="H0_dia" name="Pedir cómo sería un día usándolo">
        <bpmn:incoming>H0_f_no</bpmn:incoming>
        <bpmn:outgoing>H0_f3</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="H0_devolver" name="Devolver el mapa con sus palabras">
        <bpmn:incoming>H0_f2</bpmn:incoming>
        <bpmn:incoming>H0_f3</bpmn:incoming>
        <bpmn:outgoing>H0_f4</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="H0_criterio" name="Preguntar cuáles pasos exigen criterio">
        <bpmn:incoming>H0_f4</bpmn:incoming>
        <bpmn:outgoing>H0_f5</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="H0_vara" name="Preguntar qué se quedaría sin quien lo conteste">
        <bpmn:incoming>H0_f5</bpmn:incoming>
        <bpmn:outgoing>H0_f6</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="H0_anotar" name="Anotar la vara como hallazgos">
        <bpmn:incoming>H0_f6</bpmn:incoming>
        <bpmn:outgoing>H0_f7</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="H0_fin" name="Mapa acotado y vara puesta">
        <bpmn:incoming>H0_f7</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="H0_f1" sourceRef="H0_inicio" targetRef="H0_gw" />
      <bpmn:sequenceFlow id="H0_f_si" name="sí" sourceRef="H0_gw" targetRef="H0_mapa" />
      <bpmn:sequenceFlow id="H0_f_no" name="no" sourceRef="H0_gw" targetRef="H0_dia" />
      <bpmn:sequenceFlow id="H0_f2" sourceRef="H0_mapa" targetRef="H0_devolver" />
      <bpmn:sequenceFlow id="H0_f3" sourceRef="H0_dia" targetRef="H0_devolver" />
      <bpmn:sequenceFlow id="H0_f4" sourceRef="H0_devolver" targetRef="H0_criterio" />
      <bpmn:sequenceFlow id="H0_f5" sourceRef="H0_criterio" targetRef="H0_vara" />
      <bpmn:sequenceFlow id="H0_f6" sourceRef="H0_vara" targetRef="H0_anotar" />
      <bpmn:sequenceFlow id="H0_f7" sourceRef="H0_anotar" targetRef="H0_fin" />
      <bpmn:textAnnotation id="H0_nota_criterio">
        <bpmn:text>Se excava sólo donde dos personas con la misma información podrían decidir distinto. En los demás pasos, no.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="H0_asoc_criterio" sourceRef="H0_criterio" targetRef="H0_nota_criterio" />
      <bpmn:textAnnotation id="H0_nota_vara">
        <bpmn:text>«Si mañana no vinieras, ¿qué preguntas se quedarían sin quien las conteste?» No se hace antes del mapa: sin nada enfrente contesta una generalidad; con sus propios pasos a la vista contesta lo que de verdad sólo él sabe.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="H0_asoc_vara" sourceRef="H0_vara" targetRef="H0_nota_vara" />
      <bpmn:textAnnotation id="H0_nota_anotar">
        <bpmn:text>Ésta es la vara con la que se mide todo lo que se registre después: si al final el registro no contesta estas preguntas, no sirvió, por completo que se vea.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="H0_asoc_anotar" sourceRef="H0_anotar" targetRef="H0_nota_anotar" />
      <bpmn:textAnnotation id="H0_nota_gw">
        <bpmn:text>Lo que todavía no existe se acota al revés: los pasos salen de contar cómo sería un día usándolo, de principio a fin.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="H0_asoc_gw" sourceRef="H0_gw" targetRef="H0_nota_gw" />
    </bpmn:subProcess>
    <bpmn:subProcess id="C_excavar" name="Excavar un paso">
      <bpmn:incoming>C_f2</bpmn:incoming>
      <bpmn:incoming>C_f_vuelta</bpmn:incoming>
      <bpmn:outgoing>C_f3</bpmn:outgoing>
      <bpmn:property id="Property_1ouhyiz" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DA_mapa_in">
        <bpmn:sourceRef>DO_mapa_ref</bpmn:sourceRef>
        <bpmn:targetRef>Property_1ouhyiz</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DA_hallazgos_out">
        <bpmn:targetRef>DO_hallazgos_ref</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:startEvent id="H1_inicio" name="Paso del mapa por excavar">
        <bpmn:outgoing>H1_f1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="H1_caso" name="Pedir el último caso, o el que salió mal">
        <bpmn:incoming>H1_f1</bpmn:incoming>
        <bpmn:outgoing>H1_f2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="H1_pregunta" name="Hacer una sola de las seis preguntas">
        <bpmn:incoming>H1_f2</bpmn:incoming>
        <bpmn:incoming>H1_f_sigue</bpmn:incoming>
        <bpmn:outgoing>H1_f3</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="H1_reflejar" name="Reflejar la regla equivocándose a propósito">
        <bpmn:incoming>H1_f3</bpmn:incoming>
        <bpmn:outgoing>H1_f4</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="H1_gw_contesto" name="¿Alguien la pudo contestar?">
        <bpmn:incoming>H1_f4</bpmn:incoming>
        <bpmn:outgoing>H1_f_si</bpmn:outgoing>
        <bpmn:outgoing>H1_f_no</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="H1_abierto" name="Anotar el hallazgo como abierto">
        <bpmn:incoming>H1_f_no</bpmn:incoming>
        <bpmn:outgoing>H1_f5</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="H1_marcar" name="Anotar el hallazgo con su origen y su firmeza">
        <bpmn:incoming>H1_f_si</bpmn:incoming>
        <bpmn:outgoing>H1_f6</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="H1_gw_lista" name="¿Van cuatro o cinco intercambios?">
        <bpmn:incoming>H1_f5</bpmn:incoming>
        <bpmn:incoming>H1_f6</bpmn:incoming>
        <bpmn:outgoing>H1_f_mostrar</bpmn:outgoing>
        <bpmn:outgoing>H1_f_seguir</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="H1_mostrar" name="Mostrar la lista completa">
        <bpmn:incoming>H1_f_mostrar</bpmn:incoming>
        <bpmn:outgoing>H1_f7</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="H1_gw_agotada" name="¿Tres preguntas seguidas sin hallazgo?">
        <bpmn:incoming>H1_f_seguir</bpmn:incoming>
        <bpmn:incoming>H1_f7</bpmn:incoming>
        <bpmn:outgoing>H1_f_sigue</bpmn:outgoing>
        <bpmn:outgoing>H1_f_fin</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="H1_fin" name="Rama agotada">
        <bpmn:incoming>H1_f_fin</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="H1_f1" sourceRef="H1_inicio" targetRef="H1_caso" />
      <bpmn:sequenceFlow id="H1_f2" sourceRef="H1_caso" targetRef="H1_pregunta" />
      <bpmn:sequenceFlow id="H1_f3" sourceRef="H1_pregunta" targetRef="H1_reflejar" />
      <bpmn:sequenceFlow id="H1_f4" sourceRef="H1_reflejar" targetRef="H1_gw_contesto" />
      <bpmn:sequenceFlow id="H1_f_no" name="no" sourceRef="H1_gw_contesto" targetRef="H1_abierto" />
      <bpmn:sequenceFlow id="H1_f_si" name="sí" sourceRef="H1_gw_contesto" targetRef="H1_marcar" />
      <bpmn:sequenceFlow id="H1_f5" sourceRef="H1_abierto" targetRef="H1_gw_lista" />
      <bpmn:sequenceFlow id="H1_f6" sourceRef="H1_marcar" targetRef="H1_gw_lista" />
      <bpmn:sequenceFlow id="H1_f_mostrar" name="sí" sourceRef="H1_gw_lista" targetRef="H1_mostrar" />
      <bpmn:sequenceFlow id="H1_f_seguir" name="no" sourceRef="H1_gw_lista" targetRef="H1_gw_agotada" />
      <bpmn:sequenceFlow id="H1_f7" sourceRef="H1_mostrar" targetRef="H1_gw_agotada" />
      <bpmn:sequenceFlow id="H1_f_sigue" name="no" sourceRef="H1_gw_agotada" targetRef="H1_pregunta" />
      <bpmn:sequenceFlow id="H1_f_fin" name="sí" sourceRef="H1_gw_agotada" targetRef="H1_fin" />
      <bpmn:textAnnotation id="H1_nota_caso">
        <bpmn:text>Un experto no puede contestar en abstracto; sobre un caso sí. «¿Cómo funciona tu proceso de crédito?» da el manual oficial; «cuéntame el último que rechazaste aunque cumplía» da la regla real. Si la pregunta se puede contestar con el manual, está mal hecha.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="H1_asoc_caso" sourceRef="H1_caso" targetRef="H1_nota_caso" />
      <bpmn:textAnnotation id="H1_nota_pregunta">
        <bpmn:text>Panorama · Detección · Mañas del oficio · Improvisación · Pasado y futuro · Cuándo cambias de método. Una a la vez y no como cuestionario: dos preguntas juntas se contestan a medias, siempre. Las que más rinden son detección y mañas — justo lo que nadie documenta porque nadie cree que sea información.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="H1_asoc_pregunta" sourceRef="H1_pregunta" targetRef="H1_nota_pregunta" />
      <bpmn:textAnnotation id="H1_nota_reflejar">
        <bpmn:text>Se dice en voz alta y se falla a propósito: «entonces, si el cliente lleva más de seis meses, pasa directo, ¿así?». El experto corrige mucho más rápido de lo que explica.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="H1_asoc_reflejar" sourceRef="H1_reflejar" targetRef="H1_nota_reflejar" />
      <bpmn:textAnnotation id="H1_nota_marcar">
        <bpmn:text>Tres marcas, y la pone el consultor, no el experto: dicho — lo dijo y nadie lo ha revisado en frío; confirmado — se lo devolvió y dijo que sí, con esas palabras; abierto — nadie en la sala lo pudo contestar. Cada hallazgo lleva además de dónde salió: qué pregunta lo destapó o de qué caso salió.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="H1_asoc_marcar" sourceRef="H1_marcar" targetRef="H1_nota_marcar" />
      <bpmn:textAnnotation id="H1_nota_abierto">
        <bpmn:text>Lo que nadie puede contestar no frena la conversación: se anota abierto y se sigue. No se resuelve ahí, no se deja en el aire, no se pierde.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="H1_asoc_abierto" sourceRef="H1_abierto" targetRef="H1_nota_abierto" />
    </bpmn:subProcess>
    <bpmn:task id="C_sintocar" name="Anotar los pasos que quedaron sin tocar">
      <bpmn:incoming>C_f_tiempo</bpmn:incoming>
      <bpmn:outgoing>C_f_sintocar</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="C_anunciar" name="Anunciar el cambio de paso">
      <bpmn:incoming>C_f3</bpmn:incoming>
      <bpmn:outgoing>C_f4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:callActivity id="C_moler" name="Moler el paso">
      <bpmn:incoming>C_f4</bpmn:incoming>
      <bpmn:incoming>C_f_sintocar</bpmn:incoming>
      <bpmn:incoming>C_f_guardar</bpmn:incoming>
      <bpmn:incoming>C_f_remoler</bpmn:incoming>
      <bpmn:outgoing>C_f5</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="C_gw_molino">
      <bpmn:incoming>C_f5</bpmn:incoming>
      <bpmn:outgoing>C_f_nada</bpmn:outgoing>
      <bpmn:outgoing>C_f_listo</bpmn:outgoing>
      <bpmn:outgoing>C_f_faltan</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="C_nada" name="Decir que ese paso no dejó nada firme">
      <bpmn:incoming>C_f_nada</bpmn:incoming>
      <bpmn:outgoing>C_f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="C_contar" name="Contar al experto qué se guardó">
      <bpmn:incoming>C_f_listo</bpmn:incoming>
      <bpmn:outgoing>C_f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:subProcess id="C_preguntas" name="Cerrar las preguntas con el experto">
      <bpmn:incoming>C_f_faltan</bpmn:incoming>
      <bpmn:outgoing>C_f_remoler</bpmn:outgoing>
      <bpmn:startEvent id="H2_inicio" name="El molino paró la línea">
        <bpmn:outgoing>H2_f1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="H2_traducir" name="Traducir las preguntas a palabras del negocio">
        <bpmn:incoming>H2_f1</bpmn:incoming>
        <bpmn:outgoing>H2_f2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="H2_hacer" name="Hacer una pregunta a la vez">
        <bpmn:incoming>H2_f2</bpmn:incoming>
        <bpmn:incoming>H2_f_otra</bpmn:incoming>
        <bpmn:outgoing>H2_f3</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="H2_gw" name="¿La contestó?">
        <bpmn:incoming>H2_f3</bpmn:incoming>
        <bpmn:outgoing>H2_f_si</bpmn:outgoing>
        <bpmn:outgoing>H2_f_no</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:task id="H2_anotar" name="Anotar la respuesta como hallazgo">
        <bpmn:incoming>H2_f_si</bpmn:incoming>
        <bpmn:outgoing>H2_f4</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="H2_abierta" name="Dejarla abierta y seguir">
        <bpmn:incoming>H2_f_no</bpmn:incoming>
        <bpmn:outgoing>H2_f5</bpmn:outgoing>
      </bpmn:task>
      <bpmn:exclusiveGateway id="H2_gw_quedan" name="¿Quedan preguntas?">
        <bpmn:incoming>H2_f4</bpmn:incoming>
        <bpmn:incoming>H2_f5</bpmn:incoming>
        <bpmn:outgoing>H2_f_otra</bpmn:outgoing>
        <bpmn:outgoing>H2_f_fin</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="H2_fin" name="Preguntas cerradas con el experto">
        <bpmn:incoming>H2_f_fin</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="H2_f1" sourceRef="H2_inicio" targetRef="H2_traducir" />
      <bpmn:sequenceFlow id="H2_f2" sourceRef="H2_traducir" targetRef="H2_hacer" />
      <bpmn:sequenceFlow id="H2_f3" sourceRef="H2_hacer" targetRef="H2_gw" />
      <bpmn:sequenceFlow id="H2_f_si" name="sí" sourceRef="H2_gw" targetRef="H2_anotar" />
      <bpmn:sequenceFlow id="H2_f_no" name="no" sourceRef="H2_gw" targetRef="H2_abierta" />
      <bpmn:sequenceFlow id="H2_f4" sourceRef="H2_anotar" targetRef="H2_gw_quedan" />
      <bpmn:sequenceFlow id="H2_f5" sourceRef="H2_abierta" targetRef="H2_gw_quedan" />
      <bpmn:sequenceFlow id="H2_f_otra" name="sí" sourceRef="H2_gw_quedan" targetRef="H2_hacer" />
      <bpmn:sequenceFlow id="H2_f_fin" name="no" sourceRef="H2_gw_quedan" targetRef="H2_fin" />
      <bpmn:textAnnotation id="H2_nota_traducir">
        <bpmn:text>Llegan ya redactadas por el molino, pero llegan en su idioma. Al experto se le hacen en sus palabras: cero jerga, nada de esquema, campo, tabla o sistema.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="H2_asoc_traducir" sourceRef="H2_traducir" targetRef="H2_nota_traducir" />
      <bpmn:textAnnotation id="H2_nota_fin">
        <bpmn:text>Cerradas las preguntas, el molino se vuelve a correr con las respuestas. El experto contesta una sola corrida: sin ese tope, cada revisión encuentra algo más y no se escribe nunca.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="H2_asoc_fin" sourceRef="H2_fin" targetRef="H2_nota_fin" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="C_gw_pasos" name="¿Quedan pasos y tiempo?">
      <bpmn:incoming>C_f6</bpmn:incoming>
      <bpmn:incoming>C_f7</bpmn:incoming>
      <bpmn:outgoing>C_f_vuelta</bpmn:outgoing>
      <bpmn:outgoing>C_f_cerrar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="C_lista" name="Mostrar la lista completa de hallazgos">
      <bpmn:incoming>C_f_cerrar</bpmn:incoming>
      <bpmn:outgoing>C_f8</bpmn:outgoing>
      <bpmn:property id="Property_0yietvo" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DA_hallazgos_in">
        <bpmn:sourceRef>DO_hallazgos_ref</bpmn:sourceRef>
        <bpmn:targetRef>Property_0yietvo</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="C_gw_fin" name="¿Quedó algún paso sin tocar?">
      <bpmn:incoming>C_f8</bpmn:incoming>
      <bpmn:outgoing>C_f_huecos</bpmn:outgoing>
      <bpmn:outgoing>C_f_limpio</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="C_faltaron" name="Decir cuáles quedaron sin tocar">
      <bpmn:incoming>C_f_huecos</bpmn:incoming>
      <bpmn:outgoing>C_f9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="C_fin" name="Sesión cerrada y todo molido">
      <bpmn:incoming>C_f_limpio</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="C_fin_huecos" name="Sesión cerrada con pasos sin tocar">
      <bpmn:incoming>C_f9</bpmn:incoming>
    </bpmn:endEvent>
