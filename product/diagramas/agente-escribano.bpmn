<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definiciones_escribano" targetNamespace="http://nemawashi/diagramas" exporter="escrito a mano" exporterVersion="1.0">
  <bpmn:process id="Proceso_escribano_asentar" name="Asentar el roadmap" isExecutable="false">
    <bpmn:startEvent id="E_inicio" name="Hallazgo cerrado y limpio">
      <bpmn:outgoing>E_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="E_plantilla" name="Leer la plantilla que manda la forma">
      <bpmn:incoming>E_f1</bpmn:incoming>
      <bpmn:outgoing>E_f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="E_gw_hora" name="¿Llegó la hora con su huso?">
      <bpmn:incoming>E_f2</bpmn:incoming>
      <bpmn:outgoing>E_f3</bpmn:outgoing>
      <bpmn:outgoing>E_f_hora</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_fin_hora" name="Archivo no escrito, y reportado">
      <bpmn:incoming>E_f_hora</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="E_gw_cabe" name="¿Cabe en la plantilla?">
      <bpmn:incoming>E_f3</bpmn:incoming>
      <bpmn:outgoing>E_f4</bpmn:outgoing>
      <bpmn:outgoing>E_f_cabe</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_fin_cabe" name="Reportado sin estirar la plantilla">
      <bpmn:incoming>E_f_cabe</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="E_numerar" name="Numerar desde el último que existe">
      <bpmn:incoming>E_f4</bpmn:incoming>
      <bpmn:outgoing>E_f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="E_item" name="Escribir el ítem flaco">
      <bpmn:incoming>E_f5</bpmn:incoming>
      <bpmn:outgoing>E_f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="E_gw_cupo" name="¿Cupo el caso entero?">
      <bpmn:incoming>E_f6</bpmn:incoming>
      <bpmn:outgoing>E_f7</bpmn:outgoing>
      <bpmn:outgoing>E_f_documento</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="E_documento" name="Escribir el documento y dejar el puntero">
      <bpmn:incoming>E_f_documento</bpmn:incoming>
      <bpmn:outgoing>E_f_documento2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E_fin" name="Roadmap escrito, con lo no escrito aparte">
      <bpmn:incoming>E_f7</bpmn:incoming>
      <bpmn:incoming>E_f_documento2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="E_f1" sourceRef="E_inicio" targetRef="E_plantilla" />
    <bpmn:sequenceFlow id="E_f2" sourceRef="E_plantilla" targetRef="E_gw_hora" />
    <bpmn:sequenceFlow id="E_f3" name="sí" sourceRef="E_gw_hora" targetRef="E_gw_cabe" />
    <bpmn:sequenceFlow id="E_f_hora" name="no" sourceRef="E_gw_hora" targetRef="E_fin_hora" />
    <bpmn:sequenceFlow id="E_f4" name="sí" sourceRef="E_gw_cabe" targetRef="E_numerar" />
    <bpmn:sequenceFlow id="E_f_cabe" name="no" sourceRef="E_gw_cabe" targetRef="E_fin_cabe" />
    <bpmn:sequenceFlow id="E_f5" sourceRef="E_numerar" targetRef="E_item" />
    <bpmn:sequenceFlow id="E_f6" sourceRef="E_item" targetRef="E_gw_cupo" />
    <bpmn:sequenceFlow id="E_f7" name="sí" sourceRef="E_gw_cupo" targetRef="E_fin" />
    <bpmn:sequenceFlow id="E_f_documento" name="no" sourceRef="E_gw_cupo" targetRef="E_documento" />
    <bpmn:sequenceFlow id="E_f_documento2" sourceRef="E_documento" targetRef="E_fin" />
    <bpmn:textAnnotation id="E_nota_hora">
      <bpmn:text>La hora se pasa, no se deduce: una hora inventada se ve igual de bien que una real.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="E_asoc_hora" sourceRef="E_gw_hora" targetRef="E_nota_hora" />
    <bpmn:textAnnotation id="E_nota_cabe">
      <bpmn:text>Lo que no cabe no estira la plantilla: se reporta.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="E_asoc_cabe" sourceRef="E_gw_cabe" targetRef="E_nota_cabe" />
    <bpmn:textAnnotation id="E_nota_documento">
      <bpmn:text>El tope de letras no es permiso para resumir: es la señal de que el detalle va al documento.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="E_asoc_documento" sourceRef="E_documento" targetRef="E_nota_documento" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="E_diagrama">
    <bpmndi:BPMNPlane id="E_plano" bpmnElement="Proceso_escribano_asentar">
      <bpmndi:BPMNShape id="S_E_inicio" bpmnElement="E_inicio">
